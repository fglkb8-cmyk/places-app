        <mxCell id="dGZzikR4Ij8UVIG91Lr7" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;画面設計書&lt;/font&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
